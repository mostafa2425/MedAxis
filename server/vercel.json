{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "develop": false
    }
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/me/avatar",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    { "path": "/api/assistant/cron/daily", "schedule": "0 18 * * *" },
    { "path": "/api/assistant/cron/weekly", "schedule": "0 18 * * 5" }
  ]
}
