{
  "name": "server",
  "version": "1.0.0",
  "description": "MedAxis API server",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "predev": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts && tsx prisma/seed-governorates.ts && tsx prisma/seed-demo-operations.ts",
    "seed:governorates": "tsx prisma/seed-governorates.ts",
    "seed:operations": "tsx prisma/seed-demo-operations.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "swagger-ui-express": "^5.0.1",
    "multer": "^2.2.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.11.0",
    "@types/node": "^26.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.11",
    "typescript": "5.9.3"
  }
}
