# Development API
PORT=5000

# Supabase Development project
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_STORAGE_BUCKET=clinical-files

# Cron authentication
CRON_SECRET=<server-only-cron-secret>

# Web Push / VAPID (server-only private key)
VAPID_SUBJECT=mailto:admin@medaxis.app
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>

# Never expose SUPABASE_SERVICE_ROLE_KEY or VAPID_PRIVATE_KEY to the client.
# Production must use a separate Supabase project and storage bucket.
