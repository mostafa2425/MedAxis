# Development API
PORT=5000

# Supabase Development project
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_STORAGE_BUCKET=clinical-files

# Web app URL used by verification links
APP_URL=https://med-axis-git-develop-gamalmostafa32s-projects.vercel.app

# Brevo SMTP transactional email
BREVO_SMTP_LOGIN=<brevo-smtp-login>
BREVO_SMTP_KEY=<brevo-smtp-key>
BREVO_SENDER_EMAIL=<verified-sender-email>
BREVO_SENDER_NAME=MedAxis

# Cron authentication
CRON_SECRET=<server-only-cron-secret>

# Web Push / VAPID (server-only private key)
VAPID_SUBJECT=mailto:admin@medaxis.app
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>

# Never expose SUPABASE_SERVICE_ROLE_KEY, BREVO_SMTP_KEY or VAPID_PRIVATE_KEY to the client.
# Production must use a separate Supabase project and production APP_URL.
