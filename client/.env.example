# Local development
VITE_API_URL=http://localhost:5000/api

# Development Supabase project
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_STORAGE_BUCKET=clinical-files

# PostHog analytics
# Create these values in your PostHog project settings.
VITE_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Web Push
VITE_VAPID_PUBLIC_KEY=<same-public-key-used-by-server>

# Production
# VITE_API_URL=https://YOUR-BACKEND.vercel.app/api
# Keep production Supabase values separate from develop.
